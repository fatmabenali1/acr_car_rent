NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PRICING_CONFIRMED=false
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/athens_car_rental?schema=public"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-chars
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_UPLOAD_DIR=uploads
ADMIN_UPLOAD_MAX_BYTES=5242880
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_HOSTNAMES=localhost
RECAPTCHA_TEST_VERIFY_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO_AGENCY=
MAIL_AGENCY_TO=info@athenscarrental.com
AGENCY_EMAIL=info@athenscarrental.com
AGENCY_PHONE=+30 210 6022220
AGENCY_SECONDARY_PHONE=+30 210 6624887
PAYMENT_PORTAL_URL=
PAYMENT_PROVIDER=mock
ALPHABANK_INTEGRATION_CONFIG=
PAYMENT_PORTAL_POSTAL_CODE=19400
# Stripe Checkout requires both secret and webhook keys. The publishable key is optional
# because checkout redirects to Stripe-hosted pages. Start with test-mode keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_API_BASE_URL=
